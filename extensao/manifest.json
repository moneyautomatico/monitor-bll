{
  "manifest_version": 3,
  "name": "Expert Licitante – Monitor",
  "version": "1.3.1",
  "description": "Lê (sem enviar nada) o chat do pregoeiro na Licitanet e no Compras.gov.br, no seu Chrome, e manda os alertas para o painel Expert Licitante. Uma ou várias empresas.",
  "icons": {
    "16": "icones/16.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/16.png",
      "48": "icones/48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://portal.licitanet.com.br/*",
    "https://www.comprasnet.gov.br/*",
    "https://cnetmobile.estaleiro.serpro.gov.br/*",
    "https://expertlicitante.com.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://portal.licitanet.com.br/*"
      ],
      "js": [
        "content_licitanet.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cnetmobile.estaleiro.serpro.gov.br/*",
        "https://www.comprasnet.gov.br/*"
      ],
      "js": [
        "cg_main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://cnetmobile.estaleiro.serpro.gov.br/*",
        "https://www.comprasnet.gov.br/*"
      ],
      "js": [
        "content_comprasgov.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}